rules_version = '2';

// Modelo de datos:
//   users/{uid}                -> perfil del usuario
//   users/{uid}/lists/{listId} -> listas de compra de ese usuario
//
// Regla base: un usuario solo puede leer y escribir SU propio subárbol,
// y solo si verificó su correo (la app ya lo exige al iniciar sesión).
service cloud.firestore {
  match /databases/{database}/documents {

    // Sesión iniciada como ese usuario (puede no haber verificado el correo todavía)
    function isSignedInAs(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // Dueño del subárbol Y con el correo verificado
    function isOwner(uid) {
      return isSignedInAs(uid) && request.auth.token.email_verified == true;
    }

    function incoming() {
      return request.resource.data;
    }

    // La foto va incrustada en el propio documento como data URL (el proyecto
    // no usa Storage). Hay que acotarla: sin límite, cualquiera podría llenar
    // su documento hasta el máximo de 1 MiB de Firestore.
    // 80.000 caracteres en base64 ≈ 60 KB de imagen, de sobra para un avatar
    // de 256 px, que ronda los 20-30 KB.
    function validPhoto() {
      return !('photo' in incoming())
        || (incoming().photo is string
            && incoming().photo.size() <= 80000
            && incoming().photo.matches('data:image/(jpeg|png|webp);base64,[A-Za-z0-9+/=]*'));
    }

    // Verificación en dos pasos. El secreto se guarda aquí, donde solo lo lee
    // su dueño; se acota el tamaño para que el campo no se use como almacén.
    function validTwoFactor() {
      return !('twoFactor' in incoming())
        || (incoming().twoFactor is map
            && incoming().twoFactor.keys().hasOnly(['enabled', 'secret', 'recovery'])
            && incoming().twoFactor.enabled is bool
            && (!('secret' in incoming().twoFactor)
                || (incoming().twoFactor.secret is string && incoming().twoFactor.secret.size() <= 64))
            && (!('recovery' in incoming().twoFactor)
                || (incoming().twoFactor.recovery is string && incoming().twoFactor.recovery.size() <= 64)));
    }

    // El perfil no puede contener contraseñas ni suplantar a otro usuario
    function validProfile(uid) {
      return incoming().keys().hasOnly(['uid', 'email', 'name', 'photo', 'twoFactor'])
        && incoming().keys().hasAll(['uid', 'email', 'name'])
        && incoming().uid == uid
        && incoming().email is string
        && incoming().email == request.auth.token.email
        && incoming().name is string
        && incoming().name.size() >= 4
        && incoming().name.size() <= 50
        && validPhoto()
        && validTwoFactor();
    }

    function validList() {
      return incoming().keys().hasOnly(['id', 'title', 'status', 'dateHour', 'items', 'note', 'deletedAt', 'template', 'owner', 'sharedWith'])
        && incoming().title is string
        && incoming().title.size() > 0
        && incoming().title.size() <= 100
        && incoming().status in ['Activo', 'Completo']
        && incoming().dateHour is string
        && incoming().dateHour.size() <= 40
        && incoming().items is list
        && incoming().items.size() <= 200
        // La nota es texto libre: hay que ponerle tope como a todo lo demás
        && (!('note' in incoming())
            || (incoming().note is string && incoming().note.size() <= 500))
        // La papelera es un borrado suave: se marca la fecha en vez de borrar
        && (!('deletedAt' in incoming())
            || (incoming().deletedAt is string && incoming().deletedAt.size() <= 40))
        && (!('template' in incoming()) || incoming().template is bool)
        && (!('owner' in incoming())
            || (incoming().owner is string && incoming().owner.size() <= 40))
        && (!('sharedWith' in incoming())
            || (incoming().sharedWith is list && incoming().sharedWith.size() <= 20));
    }

    // ---- Compartir ----
    // La lista guarda correos, no uid: el cliente no puede resolver un uid
    // desde un correo, pero las reglas sí conocen el correo del token.
    function miCorreo() {
      return request.auth.token.email;
    }

    function conCorreoVerificado() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function esInvitado() {
      return conCorreoVerificado() && miCorreo() in resource.data.get('sharedWith', []);
    }

    /** Un invitado edita la lista, pero no decide con quién más se comparte */
    function noTocaElReparto() {
      return request.resource.data.get('sharedWith', []) == resource.data.get('sharedWith', [])
        && request.resource.data.get('owner', '') == resource.data.get('owner', '');
    }

    /** Salirse de una lista compartida: solo puede quitarse a sí mismo */
    function saliendoDeLaLista() {
      return !(miCorreo() in request.resource.data.get('sharedWith', []))
        && request.resource.data.get('sharedWith', []).size()
           == resource.data.get('sharedWith', []).size() - 1
        && request.resource.data.get('owner', '') == resource.data.get('owner', '');
    }

    match /users/{uid} {
      allow get, list: if isOwner(uid);
      // El registro crea el perfil antes de verificar el correo
      allow create: if isSignedInAs(uid) && validProfile(uid);
      allow update: if isOwner(uid) && validProfile(uid);
      allow delete: if isOwner(uid);

      match /lists/{listId} {
        allow read: if isOwner(uid) || esInvitado();
        allow create: if isOwner(uid) && validList();
        allow update: if (isOwner(uid) && validList())
          // El invitado edita el contenido, pero no el reparto ni el dueño
          || (esInvitado() && validList() && noTocaElReparto())
          // ...salvo para quitarse a sí mismo
          || (esInvitado() && validList() && saliendoDeLaLista());
        // Borrar la lista es cosa del dueño; el invitado solo puede salirse
        allow delete: if isOwner(uid);
      }
    }

    // Consulta de grupo: así un invitado encuentra las listas compartidas con
    // él sin saber en qué cuenta viven. Solo ve aquellas donde figura su correo.
    match /{ruta=**}/lists/{listId} {
      allow read: if esInvitado();
    }

    // Todo lo demás queda cerrado
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
